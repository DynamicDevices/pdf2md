# Google API Configuration
# Get your API key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_api_key_here

# Model to use for formatting pages WITH diagrams/images
# Options:
#   gemini-2.5-flash (fast/cheap, good balance)
#   gemini-2.5-pro (slower/better, RECOMMENDED for complex diagrams)
#   gemini-flash-latest, gemini-pro-latest (always-latest versions)
# Note: These models support vision/multimodal inputs for diagram understanding
LLM_MODEL_NAME=gemini-2.5-pro

# Model to use for text-only pages (no diagrams)
# Use a cheaper/faster model since no vision capability needed
# Options:
#   gemini-2.5-flash (good balance)
#   gemini-flash-latest (always-latest)
# Note: This can be the same as LLM_MODEL_NAME, but using flash saves costs
LLM_MODEL_TEXT_ONLY=gemini-2.5-flash

# Default paths (can be overridden via command line)
PDF_PATH=cc1312r7.pdf
OUTPUT_DIR=output_markdown
