# Google API Configuration
# Get your API key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_api_key_here

# Model to use for formatting
# Options:
#   gemini-2.5-flash (fast/cheap, good for text)
#   gemini-2.5-pro (slower/better, RECOMMENDED for diagrams and complex technical docs)
#   gemini-flash-latest, gemini-pro-latest (always-latest versions)
# Note: All these models support vision/multimodal inputs for diagram understanding
LLM_MODEL_NAME=gemini-2.5-pro

# Default paths (can be overridden via command line)
PDF_PATH=cc1312r7.pdf
OUTPUT_DIR=output_markdown
